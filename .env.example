# docker compose reads this as .env (git-ignored). Generate secrets with
#   openssl rand -hex 32
PII_TOKEN_SALT=
MASKROOM_API_KEY=
MASKROOM_ADMIN_KEY=
POSTGRES_PASSWORD=maskroom

# --- Sign-on (MASKROOM_AUTH_MODE=oidc) ---------------------------------------
# Any OpenID Connect provider. Register a confidential client whose redirect
# URI is <MASKROOM_PUBLIC_URL>/auth/callback, then fill these in.
MASKROOM_AUTH_MODE=off
MASKROOM_OIDC_ISSUER=
MASKROOM_OIDC_CLIENT_ID=maskroom
MASKROOM_OIDC_CLIENT_SECRET=
MASKROOM_SECRET_KEY=          # openssl rand -hex 32 ; signs the login state cookie
MASKROOM_SESSION_HOURS=12
MASKROOM_ADMIN_EMAILS=        # comma-separated; these become admins on first sign-in
MASKROOM_PUBLIC_URL=          # e.g. https://maskroom.yourco.example (behind a proxy)

# Bundled Keycloak (docker compose --profile keycloak). Issuer for the app when
# it runs on the host: http://localhost:8180/realms/maskroom
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
