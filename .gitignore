scripts/desktop/uia_reply_probe_report.txt

# Diagnostics and screenshots: these hold real conversation content
desktop/*.log
desktop/*.PNG
desktop/*.png

desktop/packaging/__pycache__/
desktop/packaging/build/
desktop/packaging/dist/
