# virtualenv and caches
pii_env/
__pycache__/
*.pyc

# runtime output — contains PII / re-identification data, never commit
webui/runs/
data/
*.db
*.db-wal
*.db-shm
vault*.json
*_MASKED.*
*_RESTORED.*
salary_masked_*.xlsx

# local secrets
.env
local/
*.egg-info/

# admin policy overlay exports — may hold sensitive terms (client/person names)
config/custom_policy.yaml

# office lock files
.~lock.*#

# extension build artifacts / signing keys
*.crx
*.pem

# rendered server deploy artefacts
deploy/aws/*.env

# server certificates (generated by deploy/aws/install.sh or supplied by the CA)
certs/
