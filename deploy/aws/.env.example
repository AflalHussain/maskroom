# Copy to .env next to docker-compose.yml, fill in, chmod 600. Generate secrets with
#   openssl rand -hex 32
COMPOSE_PROJECT_NAME=maskroom          # keep: nginx reaches maskroom-app-1 / maskroom-keycloak-1 by name
MASKROOM_VERSION=v0.2.0                # image tag in repo.hsenidmobile.com/hms_data/maskroom
MASKROOM_DOMAIN=safepii.hsenidmobile.com

# sign-on (Maskroom's bundled Keycloak at https://$MASKROOM_DOMAIN/sso)
MASKROOM_AUTH_MODE=oidc
MASKROOM_OIDC_CLIENT_SECRET=           # openssl rand -hex 24 ; also lands in the Keycloak client
MASKROOM_SECRET_KEY=                   # openssl rand -hex 32
MASKROOM_SESSION_HOURS=12
MASKROOM_ADMIN_EMAILS=                 # comma-separated; admins on first sign-in

# tokens and data
PII_TOKEN_SALT=                        # openssl rand -hex 32 ; never rotate casually (orphans vaults)
SESSION_TTL_HOURS=24
AUDIT_TTL_DAYS=90
POSTGRES_PASSWORD=                     # openssl rand -hex 16

# Keycloak admin console: https://$MASKROOM_DOMAIN/sso/admin/
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=               # openssl rand -hex 12
# example users imported into the realm (delete or change them in the console)
KC_STAFF_PASSWORD=
KC_ADMIN_USER_PASSWORD=

# legacy shared key for extensions not yet on 0.2.0 (optional)
MASKROOM_API_KEY=
