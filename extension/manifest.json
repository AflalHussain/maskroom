{
  "manifest_version": 3,
  "key": "",
  "name": "Maskroom for Claude",
  "version": "0.1.0",
  "description": "Pseudonymize names, identifiers and contact details in the claude.ai composer before you send, and show the real values again in replies. Needs a Maskroom server.",
  "permissions": [
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*.claudeusercontent.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://*.claudeusercontent.com/*"
      ],
      "js": [
        "tokens.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "Maskroom",
    "default_popup": "options.html"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "storage": {
    "managed_schema": "managed_schema.json"
  }
}
